# Blank means "not set" — the app ignores empty values and uses its defaults,
# so you can safely leave anything here empty.

# ------------------------------------------------------------------- qr ---
# The address phones resolve when they scan the claim QR code. This MUST be
# something a phone on the venue wifi can actually reach — a deployed URL, or
# the booth laptop's LAN address (e.g. http://192.168.1.42:3000).
# "localhost" will render a QR that no phone can open. Leave blank only if the
# kiosk is already served from a reachable address.
NEXT_PUBLIC_KIOSK_URL=

# ---------------------------------------------------------------- email ---
# Prize codes are shown on screen no matter what. Set these to also email them.
# Get a key at resend.com, verify your sending domain, then:
RESEND_API_KEY=
PRIZE_EMAIL_FROM="Chargebacks911 <arcade@chargebacks911.com>"
BOOTH_LOCATION="the Chargebacks911 booth (#123)"

# --------------------------------------------------------------- console ---
# PIN for /admin. CHANGE THIS before the event.
ADMIN_PIN=911911

# --------------------------------------------------------------- storage ---
# REQUIRED FOR ANY DEPLOYMENT. Vercel's filesystem is read-only, so without
# these nothing is saved and every claim fails. Provision with:
#   vercel integration add upstash/upstash-kv --plan free
# which sets KV_REST_API_URL / KV_REST_API_TOKEN for you — the app reads either
# naming. Set these two by hand only if you're bringing your own Upstash.
# Leave blank to fall back to ./.data/entries.json (fine on a booth laptop).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------- odds ---
# Share of slot pulls that win a real prize (losers still get the consolation).
# Pass marks for the skill games live in src/lib/quiz.ts and src/lib/catch.ts.
SLOT_WIN_RATE=0.35
